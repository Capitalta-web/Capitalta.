NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VERIFICAMEX_API_BASE_URL=https://api.verificamex.com/identity/v1
VERIFICAMEX_API_KEY=

VERIFICAMEX_RAPIDAPI_BASE_URL=https://verifier.p.rapidapi.com
VERIFICAMEX_RAPIDAPI_HOST=verifier.p.rapidapi.com
VERIFICAMEX_RAPIDAPI_KEY=

# Correo (Gmail SMTP)
SMTP_USER=
SMTP_PASS=

# Token para /api/auth/confirm-email (mínimo 16 caracteres). Si falta, el endpoint responde 401.
INTERNAL_API_TOKEN=

# Opcional: "pepper" para el hash de los códigos OTP (cadena aleatoria larga, solo en el servidor)
OTP_PEPPER=

# Asistente IA (/api/chat). Sin una de estas, /api/chat responde 503.
XAI_API_KEY=
OPENAI_API_KEY=

# LiveKit (/api/livekit/token). Sin las tres, responde 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
