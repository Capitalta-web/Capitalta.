NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VERIFICAMEX_API_BASE_URL=https://api.verificamex.com/identity/v1
VERIFICAMEX_API_KEY=

VERIFICAMEX_RAPIDAPI_BASE_URL=https://verifier.p.rapidapi.com
VERIFICAMEX_RAPIDAPI_HOST=verifier.p.rapidapi.com
VERIFICAMEX_RAPIDAPI_KEY=

# Correo (Gmail SMTP; se valida el certificado TLS)
SMTP_USER=
SMTP_PASS=

# Token para /api/auth/confirm-email (mínimo 16 caracteres). Si falta, el endpoint responde 401 (falla cerrado).
INTERNAL_API_TOKEN=

# Cron de resúmenes (/api/notifications/daily-summary y weekly-summary): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Analytics opcionales: la CSP solo permite sus dominios si están definidos (redeploy al cambiarlos).
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_ID=
